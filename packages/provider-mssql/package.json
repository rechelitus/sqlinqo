{
  "name": "@sqlinqo/mssql",
  "version": "0.1.0",
  "description": "SQL Server provider for @sqlinqo/core: dialect, driver and context factory built on the mssql package.",
  "keywords": [
    "linq",
    "sql-server",
    "mssql",
    "tsql",
    "orm",
    "sql",
    "typescript"
  ],
  "license": "MIT",
  "author": "Marcelo Santiago Villalta Echalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rechelitus/sqlinqo.git",
    "directory": "packages/provider-mssql"
  },
  "homepage": "https://github.com/rechelitus/sqlinqo#readme",
  "bugs": {
    "url": "https://github.com/rechelitus/sqlinqo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .tsbuild",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@sqlinqo/core": "workspace:^"
  },
  "peerDependencies": {
    "mssql": "^10.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "mssql": "^10.0.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
