{
  "name": "@sqlinqo/cli",
  "version": "0.1.0",
  "description": "Scaffolds @sqlinqo/core entity definitions from an existing PostgreSQL schema.",
  "keywords": [
    "sqlinqo",
    "cli",
    "scaffold",
    "codegen",
    "postgres",
    "orm",
    "typescript"
  ],
  "license": "MIT",
  "author": "Marcelo Santiago Villalta Echalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rechelitus/sqlinqo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/rechelitus/sqlinqo#readme",
  "bugs": {
    "url": "https://github.com/rechelitus/sqlinqo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sqlinqo": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .tsbuild",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@sqlinqo/core": "workspace:^",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
