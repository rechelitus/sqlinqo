{
  "name": "@sqlinqo/core",
  "version": "0.1.0",
  "description": "LINQ-style, strongly typed query engine for TypeScript. Translates arrow-function lambdas into SQL, in the spirit of Entity Framework Core.",
  "keywords": [
    "linq",
    "orm",
    "sql",
    "query-builder",
    "typescript",
    "entity-framework",
    "expression-tree"
  ],
  "license": "MIT",
  "author": "Marcelo Santiago Villalta Echalar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rechelitus/sqlinqo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rechelitus/sqlinqo#readme",
  "bugs": {
    "url": "https://github.com/rechelitus/sqlinqo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .tsbuild",
    "typecheck": "tsc --build --pretty",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
